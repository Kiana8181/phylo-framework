# =============================================================================
# Phylo-Framework configuration. Copy to .env and edit:  cp .env.example .env
#
# The values below work as-is for LOCAL DEVELOPMENT only. They are public, so a
# production deployment refuses to start with them: docker-compose.yml sets
# ENV=production for the api-prod / api-worker-prod services, and the API and
# worker then exit at start-up if any secret is missing, still equal to a value
# from this file, or (JWT_SECRET_KEY) shorter than 32 characters.
#
# REQUIRED before a production deployment - generate each with, for example:
#     openssl rand -hex 32
#   POSTGRES_PASSWORD        (and the same password inside DATABASE_URL)
#   MINIO_ROOT_PASSWORD      (and S3_SECRET_ACCESS_KEY, which must match it)
#   MINIO_METHODS_PASSWORD
#   JWT_SECRET_KEY
# Docker Compose itself also refuses to start when POSTGRES_USER,
# POSTGRES_PASSWORD, POSTGRES_DB, MINIO_ROOT_USER, MINIO_ROOT_PASSWORD,
# MINIO_METHODS_USER, MINIO_METHODS_PASSWORD or JWT_SECRET_KEY is unset.
# =============================================================================

# Deployment environment for HOST-RUN processes (./run.sh dev modes). Leave it
# as "development" here: the production containers get ENV=production from
# docker-compose.yml regardless of this line. In production, error responses
# carry a fixed message plus an error id instead of internal exception text.
ENV=development

# Interactive API docs (/docs, /redoc, /openapi.json). Default: on outside
# production, off in production. Set to true to expose them in production.
# API_DOCS_ENABLED=false

# Browser origins allowed to call the API (comma-separated). "*" is rejected in
# production.
CORS_ORIGINS=http://localhost:3000
CONTRACTS_DIR=packages/contracts
HTTP_CLIENT_TIMEOUT=600
SPEC_TIMEOUT=60

# Database Configuration
# REQUIRED. POSTGRES_PASSWORD below is a public development value: replace it
# (here and in DATABASE_URL) for production.
POSTGRES_USER=phylo_user
POSTGRES_PASSWORD=phylo_pass
POSTGRES_DB=phylo_db
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5440
DATABASE_URL=postgresql+asyncpg://phylo_user:phylo_pass@127.0.0.1:5440/phylo_db

# ---------------------------------------------------------------------------
# Object storage (self-hosted MinIO; S3-compatible). Default + documented path.
# ---------------------------------------------------------------------------
# Backend selector: minio (default) | s3 (real/compatible S3) | local (tests only)
STORAGE_BACKEND=minio

# MinIO root credentials (used by the minio container AND as the S3 creds below).
# REQUIRED. Public development values: production refuses to start with them.
MINIO_ROOT_USER=phylo_minio
MINIO_ROOT_PASSWORD=phylo_minio_secret

# Scoped MinIO user for method services: PutObject-only on the artifact bucket.
# Created by the minio-init container; injected into method service env so
# methods can upload their artifact files directly (no shared volume needed).
# REQUIRED. Replace the password for production.
MINIO_METHODS_USER=phylo_methods
MINIO_METHODS_PASSWORD=phylo_methods_secret

# S3-compatible client config (consumed by the API/worker).
# Host-run scripts/dev use localhost; containers override to http://minio:9000
# via S3_ENDPOINT_URL_DOCKER (see docker-compose.yml).
S3_ENDPOINT_URL=http://localhost:9000
S3_ENDPOINT_URL_DOCKER=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=phylo_minio
S3_SECRET_ACCESS_KEY=phylo_minio_secret
S3_BUCKET_DATASETS=phylo-datasets
S3_BUCKET_ARTIFACTS=phylo-artifacts
S3_FORCE_PATH_STYLE=true

# Host ports for the MinIO container (S3 API + web console). Only used by
# docker-compose.dev.yml (local development); the server publishes neither.
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# Local dev only: interface the MinIO S3 port is published on. The default
# 0.0.0.0 lets method containers started by ./run.sh reach it on Linux; on
# Docker Desktop you can narrow it to 127.0.0.1.
# DEV_MINIO_BIND=0.0.0.0

# Per-user storage quota (GB)
STORAGE_QUOTA_PER_USER_GB=2

# Shared staging workspace (method services read staged inputs from this mount).
# Not the dataset/artifact store anymore — that is MinIO above.
STORAGE_LOCAL_PATH=runtime/storage
STORAGE_LOCAL_URL=/storage
HOST_RUNTIME_SHARED_ROOT=/runtime/storage
METHOD_SERVICE_FILE_PREFIX=/runtime/storage

# Authentication Configuration
# REQUIRED. Signs every session token. Production needs a unique random value of
# at least 32 characters (openssl rand -hex 32); the placeholder is rejected.
# Changing it signs everyone out.
JWT_SECRET_KEY=change-this-secret-key-in-production-use-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
# Minimum length of a password chosen at sign-up or password reset.
PASSWORD_MIN_LENGTH=8

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback

# Email - Resend (password reset). Get key at resend.com
RESEND_API_KEY=
FRONTEND_URL=http://localhost:3000
EMAIL_FROM=Phylo Runner <onboarding@resend.dev>

# Common defaults
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
PUBLIC_API_BASE_URL=http://localhost:8000
STRICT_CONTRACT_ROUTES=true

# Method services (generated from config/method-services.json)
METHOD_DOWSER_HOST_PORT=8001
METHOD_DOWSER_CONTAINER_PORT=8001
METHOD_DOWSER_URL=http://localhost:8001
METHOD_DOWSER_URL_DOCKER=http://dowser:8001
METHOD_GCTREE_HOST_PORT=8002
METHOD_GCTREE_CONTAINER_PORT=8002
METHOD_GCTREE_URL=http://localhost:8002
METHOD_GCTREE_URL_DOCKER=http://gctree:8002
METHOD_BREPPHYLO_HOST_PORT=8003
METHOD_BREPPHYLO_CONTAINER_PORT=8003
METHOD_BREPPHYLO_URL=http://localhost:8003
METHOD_BREPPHYLO_URL_DOCKER=http://brepphylo:8003
METHOD_CLONALTREE_HOST_PORT=8004
METHOD_CLONALTREE_CONTAINER_PORT=8004
METHOD_CLONALTREE_URL=http://localhost:8004
METHOD_CLONALTREE_URL_DOCKER=http://clonaltree:8004
