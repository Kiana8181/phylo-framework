# =============================================================================
# Phylo-Framework configuration. Copy to .env and edit:  cp .env.example .env
#
# The values below work as-is for LOCAL DEVELOPMENT only. They are public, so a
# production deployment refuses to start with them: docker-compose.yml sets
# ENV=production for the api-prod / api-worker-prod services, and the API and
# worker then exit at start-up if any secret is missing, still equal to a value
# from this file, or (JWT_SECRET_KEY) shorter than 32 characters.
#
# REQUIRED before a production deployment - generate each with, for example:
#     openssl rand -hex 32
#   POSTGRES_PASSWORD        (and the same password inside DATABASE_URL)
#   MINIO_ROOT_PASSWORD      (and S3_SECRET_ACCESS_KEY, which must match it)
#   MINIO_METHODS_PASSWORD
#   JWT_SECRET_KEY
# Docker Compose itself also refuses to start when POSTGRES_USER,
# POSTGRES_PASSWORD, POSTGRES_DB, MINIO_ROOT_USER, MINIO_ROOT_PASSWORD,
# MINIO_METHODS_USER, MINIO_METHODS_PASSWORD or JWT_SECRET_KEY is unset.
# =============================================================================

# Deployment environment for HOST-RUN processes (./run.sh dev modes). Leave it
# as "development" here: the production containers get ENV=production from
# docker-compose.yml regardless of this line. In production, error responses
# carry a fixed message plus an error id instead of internal exception text.
ENV=development

# Interactive API docs (/docs, /redoc, /openapi.json). Default: on outside
# production, off in production. Set to true to expose them in production.
# API_DOCS_ENABLED=false

# Browser origins allowed to call the API (comma-separated). "*" is rejected in
# production.
CORS_ORIGINS=http://localhost:3000
CONTRACTS_DIR=packages/contracts
HTTP_CLIENT_TIMEOUT=600
SPEC_TIMEOUT=60

# Database Configuration
# REQUIRED. POSTGRES_PASSWORD below is a public development value: replace it
# (here and in DATABASE_URL) for production.
POSTGRES_USER=phylo_user
POSTGRES_PASSWORD=phylo_pass
POSTGRES_DB=phylo_db
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5440
DATABASE_URL=postgresql+asyncpg://phylo_user:phylo_pass@127.0.0.1:5440/phylo_db

# ---------------------------------------------------------------------------
# Object storage (self-hosted MinIO; S3-compatible). Default + documented path.
# ---------------------------------------------------------------------------
# Backend selector: minio (default) | s3 (real/compatible S3) | local (tests only)
STORAGE_BACKEND=minio

# MinIO root credentials (used by the minio container AND as the S3 creds below).
# REQUIRED. Public development values: production refuses to start with them.
MINIO_ROOT_USER=phylo_minio
MINIO_ROOT_PASSWORD=phylo_minio_secret

# Scoped MinIO user for method services: PutObject-only on the artifact bucket.
# Created by the minio-init container; injected into method service env so
# methods can upload their artifact files directly (no shared volume needed).
# REQUIRED. Replace the password for production.
MINIO_METHODS_USER=phylo_methods
MINIO_METHODS_PASSWORD=phylo_methods_secret

# S3-compatible client config (consumed by the API/worker).
# Host-run scripts/dev use localhost; containers override to http://minio:9000
# via S3_ENDPOINT_URL_DOCKER (see docker-compose.yml).
S3_ENDPOINT_URL=http://localhost:9000
S3_ENDPOINT_URL_DOCKER=http://phylo-minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=phylo_minio
S3_SECRET_ACCESS_KEY=phylo_minio_secret
S3_BUCKET_DATASETS=phylo-datasets
S3_BUCKET_ARTIFACTS=phylo-artifacts
S3_FORCE_PATH_STYLE=true

# Optional: pull the object-store images from a registry mirror you control
# instead of Docker Hub. Keep the digest (the part after @) unchanged: it is
# what guarantees the mirror serves the same image. See docs/DEPLOYMENT.md.
# PHYLO_OBJECT_STORE_IMAGE=registry.example.org/phylo/silo@sha256:32a8a777d90f3296294c9a57da5e8d397121187c4b868b2a7fc7874c726c0291
# PHYLO_OBJECT_STORE_CLIENT_IMAGE=registry.example.org/phylo/mc@sha256:cfc83108c3abb371f8fb84d99c1fdc88f8c237e022409b0081fb7c0a3be634dd

# Host ports for the MinIO container (S3 API + web console). Only used by
# docker-compose.dev.yml (local development); the server publishes neither.
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# Local dev only: interface the MinIO S3 port is published on. The default
# 0.0.0.0 lets method containers started by ./run.sh reach it on Linux; on
# Docker Desktop you can narrow it to 127.0.0.1.
# DEV_MINIO_BIND=0.0.0.0

# Per-user storage quota (GB)
STORAGE_QUOTA_PER_USER_GB=2

# Shared staging workspace (method services read staged inputs from this mount).
# Not the dataset/artifact store anymore — that is MinIO above.
STORAGE_LOCAL_PATH=runtime/storage
STORAGE_LOCAL_URL=/storage
HOST_RUNTIME_SHARED_ROOT=/runtime/storage
METHOD_SERVICE_FILE_PREFIX=/runtime/storage

# Authentication Configuration
# REQUIRED. Signs every session token. Production needs a unique random value of
# at least 32 characters (openssl rand -hex 32); the placeholder is rejected.
# Changing it signs everyone out.
JWT_SECRET_KEY=change-this-secret-key-in-production-use-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
# Minimum length of a password chosen at sign-up or password reset.
PASSWORD_MIN_LENGTH=8

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback

# Public address of the web app. Used for the links in emails (password reset,
# "view the results"), so on a server it must be the address users open.
FRONTEND_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Email (SMTP). All email goes through one SMTP server: password reset, account
# emails and run notifications. Leave SMTP_HOST empty to switch email off:
# nothing is sent, and nothing else stops working.
# The values are provided by whoever runs the mail server.
# ---------------------------------------------------------------------------
SMTP_HOST=
# Default port follows SMTP_SECURITY: 587 (starttls), 465 (ssl), 25 (none).
# SMTP_PORT=587
# starttls (default) | ssl | none
SMTP_SECURITY=starttls
# Optional login. Set both or neither. Only ever sent over TLS: a username with
# SMTP_SECURITY=none is refused as a configuration error.
SMTP_USERNAME=
SMTP_PASSWORD=
# Sender shown to recipients. Required when SMTP_HOST is set.
SMTP_FROM=Phylo Runner <phylo@example.org>
# Seconds to wait for the mail server at each step.
# SMTP_TIMEOUT_SECONDS=15
# Verify the mail server's certificate (keep true). For a server with a
# certificate from a private CA, point SMTP_TLS_CA_FILE at the CA bundle
# instead of switching verification off.
# SMTP_TLS_VERIFY=true
# SMTP_TLS_CA_FILE=

# ---------------------------------------------------------------------------
# Sign-in protection. The values below are the built-in defaults.
# ---------------------------------------------------------------------------
# CAPTCHA on the sign-in, sign-up and password-reset forms: a proof-of-work
# check solved by the visitor's browser. Self-hosted: no third-party service.
# DIFFICULTY_BITS is the work per form submission (each extra bit doubles it):
# 18 takes a browser about a tenth of a second on a laptop, 20 about half a
# second. It prices automated attempts; the limits below are what bounds them.
CAPTCHA_ENABLED=true
CAPTCHA_DIFFICULTY_BITS=18
# Seconds a challenge may be used after it was issued.
# CAPTCHA_TTL_SECONDS=300

# Rate limits, each written N/SECONDS ("0" switches that one off).
#   LOGIN_IP        sign-in attempts per client address
#   LOGIN_ACCOUNT   FAILED sign-in attempts per account; once reached, the
#                   account accepts no attempt until the window ends
#   REGISTER_IP     registrations per client address
#   FORGOT_IP       password-reset requests per client address
#   FORGOT_ACCOUNT  password-reset emails per account
#   VERIFY_IP       confirmation-email requests per client address
#   VERIFY_ACCOUNT  confirmation emails per account
AUTH_RATE_LIMITS_ENABLED=true
AUTH_LIMIT_LOGIN_IP=30/900
AUTH_LIMIT_LOGIN_ACCOUNT=10/900
AUTH_LIMIT_REGISTER_IP=10/3600
AUTH_LIMIT_FORGOT_IP=10/3600
AUTH_LIMIT_FORGOT_ACCOUNT=3/3600
AUTH_LIMIT_VERIFY_IP=10/3600
AUTH_LIMIT_VERIFY_ACCOUNT=3/3600
# Per-address limits need the visitor's real address. Behind a reverse proxy,
# name the proxy here (its address or network, comma-separated); only then is
# its X-Forwarded-For header believed. Left unset, every visitor appears to
# come from the proxy and shares one allowance. Check the result with
#   curl https://<your site's API>/auth/client-ip
# which must show your own address, not the proxy's.
# FORWARDED_ALLOW_IPS=172.18.0.0/16

# Email verification: new accounts must open an emailed link before they can
# upload data or create runs.
#   auto      (default) required when SMTP_HOST is set, otherwise not
#   required  always (without a mail server nobody could finish signing up)
#   off       never
EMAIL_VERIFICATION=auto
# Hours a confirmation link works.
# EMAIL_VERIFICATION_EXPIRE_HOURS=24

# Run notifications: one email to the owner when a run ends as DONE or ERROR,
# or expires in the queue. Cancelled runs never send one. Delivery is separate
# from run processing: a mail problem never changes a run.
# RUN_NOTIFICATIONS_ENABLED=true
# Attempts per email, and the wait before the second attempt (seconds); each
# further wait is four times longer, up to NOTIFICATION_RETRY_MAX_SECONDS.
# With the defaults: about 0, 1, 5, 21, 85 minutes and 5.7 hours, then given up.
# NOTIFICATION_MAX_ATTEMPTS=6
# NOTIFICATION_RETRY_BASE_SECONDS=60
# NOTIFICATION_RETRY_MAX_SECONDS=21600
# How often the worker looks for emails to send (seconds).
# NOTIFICATION_POLL_SECONDS=15

# ---------------------------------------------------------------------------
# Resource budget (shared server). ONE budget for the whole stack; set it to
# the share of the server this deployment may use. These are not server sizes
# and there is no built-in percentage: ask the infrastructure team.
#
# After changing any of these, regenerate the per-container limits and recreate
# the containers:
#     sh scripts/resource-plan.sh --write
#     docker compose --profile prod up -d
# (`./run.sh` prod mode does the first step for you.) Without the generated
# block, docker-compose.yml falls back to the plan for the defaults below.
# Minimums: 2.05 CPU, 6592 MiB, 2432 PIDs (one job per method service).
# ---------------------------------------------------------------------------
PHYLO_CPU_BUDGET=4
PHYLO_MEMORY_BUDGET_MB=8192
PHYLO_PIDS_BUDGET=4096
# strict: container CPU caps add up to at most the budget (always safe).
# pooled: every method service may use the whole method CPU share. The caps
#         then exceed the budget, so use it ONLY together with
#         PHYLO_CGROUP_PARENT. Memory is always split strictly.
PHYLO_RESOURCE_MODE=strict
# Optional: a host cgroup that enforces the total for all containers at once
# (for example a systemd slice created by the infrastructure team; see
# docs/DEPLOYMENT.md). Leave empty when no such cgroup exists.
# PHYLO_CGROUP_PARENT=phylo.slice

# ---------------------------------------------------------------------------
# Job execution inside the budget. Normally leave all of these unset: every
# method service reads its own container limits and derives
#   job slots        = whole CPUs of the container, but no more jobs than its
#                      memory can hold (idle service + N x job estimate, minus
#                      headroom)
#   threads per job  = whole CPUs / job slots (at least 1)
# and the worker runs as many jobs at once as the services report slots.
# A run that finds no free slot, or not enough free memory, waits in the queue.
# User-supplied parallelism (Dowser "nproc") is reduced to the threads per job.
# ---------------------------------------------------------------------------
# Share of each method container's memory limit kept free (percent).
PHYLO_MEMORY_HEADROOM_PERCENT=10
# Per method (DOWSER, BREPPHYLO, GCTREE, CLONALTREE), all optional:
#   PHYLO_<METHOD>_MAX_JOBS          jobs at once (still limited by memory)
#   PHYLO_<METHOD>_THREADS_PER_JOB   CPU budget of one job (cannot exceed the
#                                    container's CPUs)
#   PHYLO_<METHOD>_JOB_MEMORY_MB     estimated peak memory of one job. Defaults:
#                                    Dowser/BrepPhylo 950, GCtree 256,
#                                    ClonalTree 192 (measured on the sample
#                                    dataset; raise it for much larger datasets)
# PHYLO_DOWSER_MAX_JOBS=
# PHYLO_DOWSER_THREADS_PER_JOB=
# PHYLO_DOWSER_JOB_MEMORY_MB=
# Runs the worker drives at once. Unset = sum of the job slots the method
# services report (recommended).
# WORKER_MAX_CONCURRENT_RUNS=

# ---------------------------------------------------------------------------
# Limits per user on creating runs. The values below are the built-in defaults.
# ---------------------------------------------------------------------------
# Runs a user may have in any rolling 60 minutes. Counted: every run created in
# the last hour, except runs whose analysis never started (cancelled before
# anything was submitted to the method, or expired in the queue). When the
# limit is reached the run wizard is disabled and shows when the next run
# becomes possible. 0 = no limit.
MAX_RUNS_PER_USER_PER_HOUR=5
# Runs that may wait behind a user's active run.
MAX_QUEUED_RUNS_PER_USER=5
# Every run a user creates in 60 minutes, whatever became of it. Runs that never
# start are free for the limit above; this ceiling keeps "submit and cancel"
# from being repeated without end. Never applied below the hourly limit.
# 0 = no ceiling.
MAX_RUN_SUBMISSIONS_PER_USER_PER_HOUR=30

# ---------------------------------------------------------------------------
# Run limits: no run may hold a slot, or wait for one, for ever. Times are in
# seconds; the values below are the built-in defaults.
# ---------------------------------------------------------------------------
# Longest a run may execute, counted from the moment it started. A run that
# goes past it is stopped and ends as ERROR [TIMEOUT]. 0 = no limit.
RUN_TIMEOUT_SECONDS=86400
# The same for one method (DOWSER, BREPPHYLO, GCTREE, CLONALTREE); wins over
# RUN_TIMEOUT_SECONDS for that method.
# RUN_TIMEOUT_SECONDS_DOWSER=172800
# Longest a run that is ready to start may wait for a free slot (or for a
# method service that is down). After that it ends as ERROR [QUEUE_TIMEOUT]
# without having executed. 0 = no limit.
RUN_QUEUE_WAIT_TIMEOUT_SECONDS=172800
# How long a method service may stay unreachable while one of its jobs is being
# followed before that run ends as ERROR [METHOD_UNREACHABLE]. Long enough for a
# container restart, short enough not to hold the slot for hours.
# WORKER_METHOD_UNREACHABLE_SECONDS=300
# How long the worker waits for a method service to confirm that a job it was
# told to stop (cancel or timeout) has stopped.
# WORKER_CANCEL_CONFIRM_SECONDS=60
# Before a run becomes DONE the worker checks that every result file is in the
# object store. Attempts, pause between attempts, and longest wait per file
# when the store does not answer.
# ARTIFACT_VERIFY_ATTEMPTS=3
# ARTIFACT_VERIFY_RETRY_SECONDS=5
# ARTIFACT_VERIFY_TIMEOUT_SECONDS=30
# Time limit a method service applies to jobs that arrive without one. The
# worker always sends one (what is left of the run's limit), so this only
# matters for jobs submitted by other means. Empty or 0 = none.
# PHYLO_METHOD_JOB_TIMEOUT_SECONDS=

# Container log rotation: size of one log file and how many are kept, per
# container.
PHYLO_LOG_MAX_SIZE=10m
PHYLO_LOG_MAX_FILES=5

# Common defaults
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
PUBLIC_API_BASE_URL=http://localhost:8000
STRICT_CONTRACT_ROUTES=true

# Method services (generated from config/method-services.json)
METHOD_DOWSER_HOST_PORT=8001
METHOD_DOWSER_CONTAINER_PORT=8001
METHOD_DOWSER_URL=http://localhost:8001
METHOD_DOWSER_URL_DOCKER=http://phylo-dowser:8001
METHOD_GCTREE_HOST_PORT=8002
METHOD_GCTREE_CONTAINER_PORT=8002
METHOD_GCTREE_URL=http://localhost:8002
METHOD_GCTREE_URL_DOCKER=http://phylo-gctree:8002
METHOD_BREPPHYLO_HOST_PORT=8003
METHOD_BREPPHYLO_CONTAINER_PORT=8003
METHOD_BREPPHYLO_URL=http://localhost:8003
METHOD_BREPPHYLO_URL_DOCKER=http://phylo-brepphylo:8003
METHOD_CLONALTREE_HOST_PORT=8004
METHOD_CLONALTREE_CONTAINER_PORT=8004
METHOD_CLONALTREE_URL=http://localhost:8004
METHOD_CLONALTREE_URL_DOCKER=http://phylo-clonaltree:8004
