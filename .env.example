CORS_ORIGINS=http://localhost:3000
CONTRACTS_DIR=packages/contracts
HTTP_CLIENT_TIMEOUT=600
SPEC_TIMEOUT=60

# Database Configuration
POSTGRES_USER=phylo_user
POSTGRES_PASSWORD=phylo_pass
POSTGRES_DB=phylo_db
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5440
DATABASE_URL=postgresql+asyncpg://phylo_user:phylo_pass@127.0.0.1:5440/phylo_db

# ---------------------------------------------------------------------------
# Object storage (self-hosted MinIO; S3-compatible). Default + documented path.
# ---------------------------------------------------------------------------
# Backend selector: minio (default) | s3 (real/compatible S3) | local (tests only)
STORAGE_BACKEND=minio

# MinIO root credentials (used by the minio container AND as the S3 creds below).
# CHANGE THESE for any non-local deployment.
MINIO_ROOT_USER=phylo_minio
MINIO_ROOT_PASSWORD=phylo_minio_secret

# Scoped MinIO user for method services: PutObject-only on the artifact bucket.
# Created by the minio-init container; injected into method service env so
# methods can upload their artifact files directly (no shared volume needed).
MINIO_METHODS_USER=phylo_methods
MINIO_METHODS_PASSWORD=phylo_methods_secret

# S3-compatible client config (consumed by the API/worker).
# Host-run scripts/dev use localhost; containers override to http://minio:9000
# via S3_ENDPOINT_URL_DOCKER (see docker-compose.yml).
S3_ENDPOINT_URL=http://localhost:9000
S3_ENDPOINT_URL_DOCKER=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=phylo_minio
S3_SECRET_ACCESS_KEY=phylo_minio_secret
S3_BUCKET_DATASETS=phylo-datasets
S3_BUCKET_ARTIFACTS=phylo-artifacts
S3_FORCE_PATH_STYLE=true

# Host ports for the MinIO container (S3 API + web console).
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Per-user storage quota (GB)
STORAGE_QUOTA_PER_USER_GB=2

# Shared staging workspace (method services read staged inputs from this mount).
# Not the dataset/artifact store anymore — that is MinIO above.
STORAGE_LOCAL_PATH=runtime/storage
STORAGE_LOCAL_URL=/storage
HOST_RUNTIME_SHARED_ROOT=/runtime/storage
METHOD_SERVICE_FILE_PREFIX=/runtime/storage

# Authentication Configuration
JWT_SECRET_KEY=change-this-secret-key-in-production-use-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback

# Email - Resend (password reset). Get key at resend.com
RESEND_API_KEY=
FRONTEND_URL=http://localhost:3000
EMAIL_FROM=Phylo Runner <onboarding@resend.dev>

# Common defaults
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
PUBLIC_API_BASE_URL=http://localhost:8000
STRICT_CONTRACT_ROUTES=true

# Method services (generated from config/method-services.json)
METHOD_DOWSER_HOST_PORT=8001
METHOD_DOWSER_CONTAINER_PORT=8001
METHOD_DOWSER_URL=http://localhost:8001
METHOD_DOWSER_URL_DOCKER=http://dowser:8001
METHOD_GCTREE_HOST_PORT=8002
METHOD_GCTREE_CONTAINER_PORT=8002
METHOD_GCTREE_URL=http://localhost:8002
METHOD_GCTREE_URL_DOCKER=http://gctree:8002
METHOD_BREPPHYLO_HOST_PORT=8003
METHOD_BREPPHYLO_CONTAINER_PORT=8003
METHOD_BREPPHYLO_URL=http://localhost:8003
METHOD_BREPPHYLO_URL_DOCKER=http://brepphylo:8003
METHOD_CLONALTREE_HOST_PORT=8004
METHOD_CLONALTREE_CONTAINER_PORT=8004
METHOD_CLONALTREE_URL=http://localhost:8004
METHOD_CLONALTREE_URL_DOCKER=http://clonaltree:8004
