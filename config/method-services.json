      "containerPort": 8003,
      "composeHost": "brepphylo",
      "path": "services/brepphylo",
      "dockerImage": "phylo-brepphylo:dev"
    },
    {
      "id": "clonaltree",
      "name": "ClonalTree",
      "port": 8004,
      "containerPort": 8004,
      "composeHost": "clonaltree",
