{
  "name": "phylo-framework",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
    "dependencies": {
    "inquirer": "^9.3.7"
  },
  "scripts": {
    "build": "npm -w @phylo/contracts run build && npm -w web run build",
    "dev:web": "npm -w web run dev",
    "dev:api": "uvicorn apps.api.main:app --reload --host 0.0.0.0 --port 8000",
    "lint": "npm -w web run lint",
    "phylo:run": "node ./select-mode.mjs",
    "phylo:dev:docker": "bash ./dev-with-docker.sh",
    "phylo:dev:r": "bash ./dev-with-local-r.sh",
    "phylo:prod": "docker compose up -d --build"
  }
}
