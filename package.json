{
  "name": "phylo-framework",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "inquirer": "^9.3.7"
  },
  "scripts": {
    "version:capture": "python3 scripts/generate_version_info.py",
    "build": "npm run version:capture && npm -w @phylo/contracts run build && npm -w web run build",
    "dev:web": "node --env-file=.env ./scripts/dev-web.mjs",
    "dev:api": "node --env-file=.env ./scripts/dev-api.mjs",
    "dev:worker": "node --env-file=.env ./scripts/dev-worker.mjs",
    "lint": "npm -w web run lint",
    "test": "node scripts/test.mjs",
    "phylo:run": "node ./scripts/select-mode.mjs",
    "phylo:dev:docker": "bash ./scripts/dev-with-docker.sh",
    "phylo:dev:r": "bash ./scripts/dev-with-local-r.sh",
    "phylo:prod": "./run.sh prod",
    "db:migrate": "alembic upgrade head",
    "storage:check": "node --env-file=.env ./scripts/storage-check.mjs",
    "storage:check:docker": "node --env-file=.env ./scripts/storage-check.mjs --docker",
    "services:sync-env": "node scripts/method-services.mjs sync-env",
    "services:list": "node scripts/method-services.mjs list",
    "services:start": "node scripts/method-services.mjs start",
    "services:stop": "node scripts/method-services.mjs stop",
    "test:all": "node scripts/test.mjs --full",
    "test:js": "npm -w @phylo/contracts run test && npm -w web run test",
    "test:coverage": "node scripts/test.mjs --full",
    "test:e2e": "playwright test",
    "test:r": "node scripts/test-r.mjs",
    "test:system": "node scripts/test-system.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@vitest/coverage-v8": "3.2.7",
    "istanbul-lib-coverage": "3.2.2",
    "istanbul-lib-instrument": "6.0.3",
    "istanbul-lib-report": "3.0.1",
    "istanbul-lib-source-maps": "5.0.6",
    "istanbul-reports": "3.2.0",
    "jsdom": "26.1.0",
    "postcss": "^8.5.29"
  },
  "overrides": {
    "next": {
      "postcss": "$postcss"
    }
  }
}
