{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BrepPhylo result schema",
  "type": "object",
  "properties": {
    "ok": {
      "type": "boolean",
      "description": "True if the BrepPhylo run finished successfully."
    },
    "trees": {
      "type": "array",
      "description": "One Newick tree per clone, aligned with annotations and clones.clone_id.",
      "items": {
        "type": "string"
      }
    },
    "figures": {
      "type": "object",
      "description": "Rendered tree plots per clone.",
      "properties": {
        "phylogeny": {
          "type": "array",
          "description": "Per-clone PNG plots as plain base64-encoded blobs.",
          "items": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "phylogeny_pdf": {
          "type": "array",
          "description": "Per-clone PDF plots as base64 blobs.",
          "items": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "annotations": {
      "type": "array",
      "description": "Per-clone list of per-sequence annotation objects synced to final tree tips.",
      "items": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "original_sequence_id": {
              "type": "string"
            },
            "final_tip_label": {
              "type": "string"
            },
            "clone_id": {
              "type": "string"
            },
            "label": {
              "type": "string"
            }
          },
          "additionalProperties": true
        }
      }
    },
    "clones": {
      "type": "object",
      "description": "Lightweight per-clone summary aligned with trees and annotations.",
      "properties": {
        "clone_id": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "seqs": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        }
      },
      "additionalProperties": false
    },
    "analysis": {
      "type": "object",
      "description": "BrepPhylo batch analysis outputs (CSR, arborescence, distance-from-germline).",
      "properties": {
        "batch_summary": {
          "type": "object",
          "properties": {
            "clones_analyzed": {
              "type": "integer"
            },
            "clones_skipped": {
              "type": "integer"
            },
            "csr_total": {
              "type": "integer"
            },
            "distance_rows": {
              "type": "integer"
            }
          },
          "additionalProperties": true
        },
        "distance_from_germline": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "clone_id": {
                "type": "string"
              },
              "sequence_id": {
                "type": "string"
              },
              "distance": {
                "type": "number"
              }
            },
            "required": [
              "clone_id",
              "sequence_id"
            ]
          }
        },
        "csr_events": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "clone_id": {
                "type": "string"
              },
              "from_isotype": {
                "type": "string"
              },
              "to_isotype": {
                "type": "string"
              },
              "distance_from_germline": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "valid": {
                "type": [
                  "boolean",
                  "null"
                ]
              }
            },
            "required": [
              "clone_id"
            ]
          }
        },
        "csr_summary": {
          "type": "array",
          "description": "Output of BrepPhylo::summariseCSR() when available; otherwise empty.",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "csr_summary_fallback": {
          "type": "object",
          "description": "Internal fallback counts grouped by from->to isotype switch.",
          "additionalProperties": {
            "type": "integer"
          }
        },
        "arborescence": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "clone_id": {
                "type": "string"
              },
              "edges": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "startID": {
                      "type": [
                        "string",
                        "number"
                      ]
                    },
                    "endID": {
                      "type": [
                        "string",
                        "number"
                      ]
                    },
                    "weight": {
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "startLabel": {
                      "type": "string"
                    },
                    "endLabel": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "required": [
              "clone_id",
              "edges"
            ]
          }
        },
        "isotype_switch_validity": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "clone_id": {
                "type": "string"
              },
              "sequence_id_from": {
                "type": "string"
              },
              "sequence_id_to": {
                "type": "string"
              },
              "from_isotype": {
                "type": "string"
              },
              "to_isotype": {
                "type": "string"
              },
              "valid": {
                "type": [
                  "boolean",
                  "null"
                ]
              }
            },
            "required": [
              "clone_id"
            ]
          }
        },
        "per_clone_status": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "clone_id": {
                "type": "string"
              },
              "n_seqs": {
                "type": "integer"
              },
              "analyzed": {
                "type": "boolean"
              },
              "status": {
                "type": "string",
                "enum": [
                  "analyzed",
                  "skipped",
                  "failed"
                ]
              },
              "skip_reason": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "clone_id",
              "n_seqs",
              "analyzed",
              "status"
            ]
          }
        },
        "skipped_clones": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "clone_id": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            },
            "required": [
              "clone_id",
              "reason"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "diagnostics": {
      "type": "object",
      "description": "Validation and mapping diagnostics from the wrapper.",
      "properties": {
        "dropped_rows": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "row_index": {
                "type": "integer"
              },
              "sequence_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "clone_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "reason": {
                "type": "string"
              }
            },
            "required": [
              "row_index",
              "reason"
            ]
          }
        },
        "rejected_rows": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "row_index": {
                "type": "integer"
              },
              "sequence_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "clone_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "reason": {
                "type": "string"
              }
            },
            "required": [
              "row_index",
              "reason"
            ]
          }
        },
        "unmapped_input_rows": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "row_index": {
                "type": "integer"
              },
              "sequence_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "clone_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "label": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "unmapped_tree_tips": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "clone_id": {
                "type": "string"
              },
              "final_tip_label": {
                "type": "string"
              }
            }
          }
        },
        "mixed_germline_clones": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "clone_id": {
                "type": "string"
              },
              "distinct_germlines": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "clone_id",
              "distinct_germlines"
            ]
          }
        },
        "latex_available": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Set when make_alignment_pdf=true; indicates LaTeX toolchain availability."
        }
      },
      "additionalProperties": false
    },
    "stats": {
      "type": "object",
      "description": "Run-level metadata and summary statistics.",
      "properties": {
        "method": {
          "type": "string"
        },
        "tree_type_requested": {
          "type": [
            "string",
            "null"
          ]
        },
        "tree_type": {
          "type": "string"
        },
        "input_sequence_mode": {
          "type": "string"
        },
        "species": {
          "type": "string"
        },
        "species_effective": {
          "type": [
            "string",
            "null"
          ]
        },
        "algorithm": {
          "type": [
            "string",
            "null"
          ]
        },
        "plot_type": {
          "type": "string"
        },
        "plot_format": {
          "type": "string"
        },
        "min_clone_size": {
          "type": "integer"
        },
        "gather_plots": {
          "type": "boolean"
        },
        "enable_csr_analysis": {
          "type": "boolean"
        },
        "sequence_column": {
          "type": "string"
        },
        "clone_id_column": {
          "type": "string"
        },
        "germline_id_column": {
          "type": "string"
        },
        "label_column": {
          "type": [
            "string",
            "null"
          ]
        },
        "isotype_column": {
          "type": [
            "string",
            "null"
          ]
        },
        "which_clones": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "ignore_clones": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "n_clones": {
          "type": "integer"
        },
        "n_trees": {
          "type": "integer"
        },
        "tree_inference_seconds": {
          "type": [
            "number",
            "null"
          ]
        },
        "analysis_seconds": {
          "type": [
            "number",
            "null"
          ]
        },
        "ig_stop_policy": {
          "type": [
            "string",
            "null"
          ]
        },
        "igphyml_fallback_to_dnapars": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "artifact_zip_b64": {
      "type": [
        "object",
        "null"
      ],
      "description": "Deprecated. Legacy base64 bundle; new services emit artifact_files (paths).",
      "properties": {
        "clone_bundle_zip": {
          "type": [
            "string",
            "null"
          ],
          "description": "ZIP of BrepPhylo output files (base64-encoded; deprecated)."
        }
      },
      "additionalProperties": true
    },
    "artifact_files": {
      "type": [
        "array",
        "null"
      ],
      "description": "List of artifact file descriptors uploaded directly to object storage by the method service. Each entry carries the object key in the artifact bucket plus content metadata for the API worker to register.",
      "items": {
        "type": "object",
        "properties": {
          "object_key": {
            "type": "string",
            "description": "Object key inside the artifact bucket (e.g. artifacts/<run_id>/<job_id>/<filename>)."
          },
          "filename": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "role": {
            "type": [
              "string",
              "null"
            ]
          },
          "content_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "previewable": {
            "type": "boolean"
          },
          "tree_index": {
            "type": [
              "integer",
              "null"
            ]
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "checksum_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "path": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "logs": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "step": {
                "type": "string"
              },
              "ok": {
                "type": "boolean"
              },
              "out": {
                "type": "string"
              }
            },
            "required": [
              "step",
              "ok",
              "out"
            ],
            "additionalProperties": true
          }
        }
      ]
    },
    "render": {
      "type": [
        "string",
        "null"
      ]
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "ok"
  ],
  "additionalProperties": true
}