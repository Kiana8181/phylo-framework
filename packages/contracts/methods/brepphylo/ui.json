{
  "requiresFile": true,
  "maxFiles": 1,
  "uploadGuidance": [
    "BrepPhylo accepts TSV and CSV.",
    "If you want to compare across methods, upload a format accepted by all desired methods."
  ],
  "fileLabel": "AIRR / rearrangement table (CSV or TSV)",

  "order": [
    "sequence_column",
    "clone_id_column",
    "germline_id_column",
    "label_column",

    "which_clones",
    "ignore_clones",

    "input_sequence_mode",
    "tree_type",
    "collapse_and_replace",
    "igphyml_accuracy",
    "make_alignment_pdf",

    "min_clone_size",
    "species",
    "germline_set_text",
    "algorithm",
    "plot_type",
    "plot_format",
    "gather_plots",

    "enable_csr_analysis",
    "isotype_column"
  ],

  "sections": [
    {
      "id": "inputColumns",
      "label": "Input Columns",
      "order": 0,
      "fields": ["sequence_column", "clone_id_column", "germline_id_column", "label_column"]
    },
    {
      "id": "cloneSelection",
      "label": "Clone Selection",
      "order": 1,
      "fields": ["which_clones", "ignore_clones", "min_clone_size"]
    },
    {
      "id": "inputPreparation",
      "label": "Input Preparation",
      "order": 2,
      "fields": ["input_sequence_mode", "algorithm", "species", "germline_set_text"]
    },
    {
      "id": "treeInference",
      "label": "Tree Inference",
      "order": 3,
      "fields": ["tree_type", "collapse_and_replace", "igphyml_accuracy", "make_alignment_pdf"]
    },
    {
      "id": "outputPlots",
      "label": "Output Plots",
      "order": 4,
      "fields": ["plot_type", "plot_format", "gather_plots"]
    },
    {
      "id": "csrIsotypeAnalysis",
      "label": "CSR / Isotype Analysis",
      "order": 5,
      "fields": ["enable_csr_analysis", "isotype_column"]
    }
  ],

  "widgets": {
    "germline_set_text": "textarea"
  },

  "visibility": {
    "collapse_and_replace": {
      "when": { "tree_type": "dnapars" }
    },
    "igphyml_accuracy": {
      "when": { "tree_type": "igphyml" }
    },
    "algorithm": {
      "when": { "input_sequence_mode": "raw_sequence" }
    },
    "germline_set_text": {
      "when": { "species": "custom" }
    },
    "isotype_column": {
      "when": { "enable_csr_analysis": true }
    }
  },

  "placeholders": {
    "sequence_column":    "sequence",
    "clone_id_column":    "clone_id",
    "germline_id_column": "V.GENE.and.allele",
    "label_column":       "optional; Seq_ID / sequence_id",

    "which_clones":       "optional; e.g. c1, c2 c3",
    "ignore_clones":      "optional; comma/space-separated clone IDs to exclude",

    "germline_set_text":  ">IGHV1-69*01\nCAGGTGCAGCTGGTGGAG...",
    "isotype_column":     "e.g. subclass, c_call, isotype",

    "algorithm":          "Default: ClustalOmega"
  }
}
