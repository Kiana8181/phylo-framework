{
  "type": "object",
  "properties": {
    "doMapping": {
      "type": "boolean",
      "title": "Enable input column mapping",
      "description": "When true, map uploaded tabular headers to canonical ClonalTree AIRR keys before safe conversions.",
      "default": false
    },
    "column_map": {
      "type": "object",
      "title": "Input Column Mapping",
      "description": "Map canonical ClonalTree keys to source table columns.",
      "properties": {
        "sequence_id": { "type": "string", "title": "Sequence ID column", "default": "" },
        "sequence": { "type": "string", "title": "Full sequence column", "default": "" },
        "productive": { "type": "string", "title": "Productive column", "default": "" },
        "v_call": { "type": "string", "title": "V call column", "default": "" },
        "d_call": { "type": "string", "title": "D call column", "default": "" },
        "j_call": { "type": "string", "title": "J call column", "default": "" },
        "v_identity": { "type": "string", "title": "V identity column", "default": "" },
        "d_identity": { "type": "string", "title": "D identity column", "default": "" },
        "j_identity": { "type": "string", "title": "J identity column", "default": "" },
        "sequence_alignment": { "type": "string", "title": "Sequence alignment column", "default": "" },
        "germline_alignment_d_mask": { "type": "string", "title": "Germline alignment (masked) column", "default": "" },
        "j_sequence_alignment": { "type": "string", "title": "J sequence alignment column", "default": "" },
        "v_sequence_alignment": { "type": "string", "title": "V sequence alignment column", "default": "" },
        "j_sequence_alignment_aa": { "type": "string", "title": "J sequence alignment aa column", "default": "" },
        "v_sequence_alignment_aa": { "type": "string", "title": "V sequence alignment aa column", "default": "" },
        "junction_aa": { "type": "string", "title": "Junction aa column", "default": "" },
        "cdr3_aa": { "type": "string", "title": "CDR3 aa column", "default": "" },
        "cdr1": { "type": "string", "title": "CDR1 column", "default": "" },
        "cdr2": { "type": "string", "title": "CDR2 column", "default": "" },
        "cdr3": { "type": "string", "title": "CDR3 nucleotide column", "default": "" },
        "fwr1": { "type": "string", "title": "FWR1 column", "default": "" },
        "fwr2": { "type": "string", "title": "FWR2 column", "default": "" },
        "fwr3": { "type": "string", "title": "FWR3 column", "default": "" },
        "fwr4": { "type": "string", "title": "FWR4 column", "default": "" },
        "v_germline_alignment": { "type": "string", "title": "V germline alignment column", "default": "" },
        "d_germline_alignment": { "type": "string", "title": "D germline alignment column", "default": "" },
        "j_germline_alignment": { "type": "string", "title": "J germline alignment column", "default": "" },
        "np1": { "type": "string", "title": "NP1 column", "default": "" },
        "np2": { "type": "string", "title": "NP2 column", "default": "" },
        "v_sequence_start": { "type": "string", "title": "V sequence start column", "default": "" },
        "cdr1_start": { "type": "string", "title": "CDR1 start column", "default": "" },
        "cdr1_end": { "type": "string", "title": "CDR1 end column", "default": "" },
        "cdr2_start": { "type": "string", "title": "CDR2 start column", "default": "" },
        "cdr2_end": { "type": "string", "title": "CDR2 end column", "default": "" },
        "cdr3_start": { "type": "string", "title": "CDR3 start column", "default": "" },
        "cdr3_end": { "type": "string", "title": "CDR3 end column", "default": "" },
        "d_sequence_start": { "type": "string", "title": "D sequence start column", "default": "" },
        "d_sequence_end": { "type": "string", "title": "D sequence end column", "default": "" }
      }
    },
    "run_name": {
      "type": "string",
      "title": "Run label",
      "description": "Optional label used as the output prefix; defaults to the uploaded file name without extension."
    },
    "abundance_threshold": {
      "type": "integer",
      "title": "Unique sequence abundance threshold",
      "description": "Minimum count threshold passed to AIRR formatting (format_labeling_imgt_airr.py -t). Set to 0 to retain every sequence occurring at least once.",
      "minimum": 0,
      "default": 3
    },
    "clone_cdr3_similarity": {
      "type": "number",
      "title": "Initial clone CDR3 threshold",
      "description": "Initial clustering threshold (initial_clustering.py -t).",
      "minimum": 0,
      "maximum": 1,
      "default": 0.7
    },
    "top_clones": {
      "type": "integer",
      "title": "Top clones for trees",
      "description": "Number of top clones to analyze (top_clones.py -s / setting NUMBER_TOP_CLONE).",
      "minimum": 1,
      "default": 5
    },
    "clonotypes_per_clone": {
      "type": "string",
      "title": "Clonotypes per clone",
      "description": "Comma/space-separated clonotype counts per selected clone (e.g. \"30, 200\" or \"all\").",
      "default": "30, 200"
    },
    "use_input_alignment": {
      "type": "boolean",
      "title": "Use input alignment directly",
      "description": "Skip ClonalTree's MUSCLE alignment step and build trees from the existing sequence_alignment column. Requires germline_alignment_d_mask for the germline root.",
      "default": false
    },
    "use_refinement": {
      "type": "boolean",
      "title": "Run refinement step",
      "description": "Run refinement.py before two-level clonotype grouping.",
      "default": true
    },
    "v_distance": {
      "type": "integer",
      "title": "V distance method",
      "description": "Refinement V-distance mode: 1=Binary, 2=Levenshtein, 3=GIANA, 4=K-mers.",
      "enum": [1, 2, 3, 4],
      "default": 1
    },
    "j_distance": {
      "type": "integer",
      "title": "J distance method",
      "description": "Refinement J-distance mode: 1=Binary, 2=Levenshtein, 3=GIANA, 4=K-mers.",
      "enum": [1, 2, 3, 4],
      "default": 2
    },
    "cdr3_distance": {
      "type": "integer",
      "title": "CDR3 distance method",
      "description": "Refinement CDR3-distance mode: 1=Binary, 2=Levenshtein, 3=GIANA, 4=K-mers.",
      "enum": [1, 2, 3, 4],
      "default": 2
    },
    "combine_distance": {
      "type": "integer",
      "title": "Distance combine method",
      "description": "Refinement combine mode: 1=Mean, 2=Weighted Mean, 3=Harmonic Mean.",
      "enum": [1, 2, 3],
      "default": 1
    },
    "merge_singleton": {
      "type": "boolean",
      "title": "Merge singleton clones",
      "description": "Allow refinement to merge singleton clusters (setting MERGE_SINGLETON).",
      "default": true
    },
    "clonotype_method": {
      "type": "string",
      "title": "Clonotype definition method",
      "description": "Two-level clonotype method: L1, L2, L3, L4, or L5.",
      "enum": ["L1", "L2", "L3", "L4", "L5"],
      "default": "L3"
    },
    "clonotype_similarity_threshold": {
      "type": "number",
      "title": "Clonotype similarity threshold",
      "description": "Similarity threshold used by methods L4 and L5.",
      "minimum": 0,
      "maximum": 1,
      "default": 0.8
    },
    "tree_use_abundance": {
      "type": "boolean",
      "title": "Weight trees by abundance",
      "description": "clonal_tree.py -a 0 enables abundance weighting.",
      "default": true
    },
    "tree_revision": {
      "type": "boolean",
      "title": "Enable tree revision",
      "description": "clonal_tree.py -r 0 enables revision.",
      "default": true
    },
    "number_top_clone": {
      "type": "integer",
      "title": "Deprecated top clone alias",
      "description": "Deprecated alias for top_clones.",
      "minimum": 1,
      "deprecated": true
    },
    "initial_clustering_threshold": {
      "type": "number",
      "title": "Deprecated clustering threshold alias",
      "description": "Deprecated alias for clone_cdr3_similarity.",
      "minimum": 0,
      "maximum": 1,
      "deprecated": true
    }
  },
  "required": [
    "clone_cdr3_similarity",
    "top_clones",
    "clonotypes_per_clone"
  ]
}
