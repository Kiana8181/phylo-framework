    "abundance_threshold",
    "clone_cdr3_similarity",
    "top_clones",
    "clonotypes_per_clone",
    "use_refinement",
    "v_distance",
    "j_distance",
    "cdr3_distance",
    "combine_distance",
    "merge_singleton",
    "clonotype_method",
    "clonotype_similarity_threshold",
    "tree_use_abundance",
    "tree_revision"
  ],

  "placeholders": {
    "run_name": "defaults to input file name",
    "clonotypes_per_clone": "30, 200 or all"
  }
}
