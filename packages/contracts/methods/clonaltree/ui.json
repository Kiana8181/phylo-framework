{
  "requiresFile": true,
  "maxFiles": 1,
  "uploadGuidance": [
    "ClonalTree accepts TSV. You can also upload CSV; conversion is applied when possible.",
    "If you want to compare across methods, upload a format accepted by all desired methods."
  ],
  "fileLabel": "AIRR / IMGT HighV-QUEST TSV",
  "order": [
    "doMapping",
    "column_map.sequence_id",
    "column_map.productive",
    "column_map.v_call",
    "column_map.d_call",
    "column_map.j_call",
    "column_map.sequence_alignment",
    "column_map.j_sequence_alignment",
    "column_map.v_sequence_alignment",
    "column_map.j_sequence_alignment_aa",
    "column_map.v_sequence_alignment_aa",
    "column_map.junction_aa",
    "column_map.cdr3_aa",

    "run_name",
    "abundance_threshold",
    "clone_cdr3_similarity",
    "top_clones",
    "clonotypes_per_clone",
    "use_refinement",
    "v_distance",
    "j_distance",
    "cdr3_distance",
    "combine_distance",
    "merge_singleton",
    "clonotype_method",
    "clonotype_similarity_threshold",
    "tree_use_abundance",
    "tree_revision"
  ],
  "sections": [
    {
      "id": "inputMapping",
      "label": "Input Mapping",
      "order": 0,
      "fields": [
        "doMapping",
        "column_map.sequence_id",
        "column_map.productive",
        "column_map.v_call",
        "column_map.d_call",
        "column_map.j_call",
        "column_map.sequence_alignment",
        "column_map.j_sequence_alignment",
        "column_map.v_sequence_alignment",
        "column_map.j_sequence_alignment_aa",
        "column_map.v_sequence_alignment_aa",
        "column_map.junction_aa",
        "column_map.cdr3_aa"
      ]
    }
  ],
  "placeholders": {
    "column_map.sequence_id": "e.g. sequence_id",
    "column_map.productive": "e.g. productive",
    "column_map.v_call": "e.g. v_call",
    "column_map.d_call": "e.g. d_call",
    "column_map.j_call": "e.g. j_call",
    "column_map.sequence_alignment": "e.g. sequence_alignment",
    "column_map.j_sequence_alignment": "e.g. j_sequence_alignment",
    "column_map.v_sequence_alignment": "e.g. v_sequence_alignment",
    "column_map.j_sequence_alignment_aa": "e.g. j_sequence_alignment_aa",
    "column_map.v_sequence_alignment_aa": "e.g. v_sequence_alignment_aa",
    "column_map.junction_aa": "e.g. junction_aa",
    "column_map.cdr3_aa": "e.g. cdr3_aa",
    "run_name": "defaults to input file name",
    "clonotypes_per_clone": "30, 200 or all"
  },
  "visibility": {
    "column_map.sequence_id": { "when": { "doMapping": true } },
    "column_map.productive": { "when": { "doMapping": true } },
    "column_map.v_call": { "when": { "doMapping": true } },
    "column_map.d_call": { "when": { "doMapping": true } },
    "column_map.j_call": { "when": { "doMapping": true } },
    "column_map.sequence_alignment": { "when": { "doMapping": true } },
    "column_map.j_sequence_alignment": { "whenAll": [{ "doMapping": true }, { "use_refinement": true }] },
    "column_map.v_sequence_alignment": { "whenAll": [{ "doMapping": true }, { "use_refinement": true }] },
    "column_map.j_sequence_alignment_aa": { "whenAll": [{ "doMapping": true }, { "use_refinement": true }] },
    "column_map.v_sequence_alignment_aa": { "whenAll": [{ "doMapping": true }, { "use_refinement": true }] },
    "column_map.junction_aa": { "when": { "doMapping": true } },
    "column_map.cdr3_aa": { "when": { "doMapping": true } }
  }
}
