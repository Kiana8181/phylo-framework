{
  "requiresFile": true,
  "maxFiles": 1,
  "uploadGuidance": [
    "Dowser accepts TSV, CSV, RDA, and RDS.",
    "If you want to compare across methods, upload a format accepted by all desired methods."
  ],
  "order": [
    "doMapping",
    "column_map.sequence_id",
    "column_map.clone_id",
    "column_map.sequence_alignment",
    "column_map.germline_alignment_d_mask",
    "column_map.v_call",
    "column_map.j_call",
    "column_map.junction",

    "tree_model",
    "minseq",
    "nproc",
    "label_field",
    "tip_color_by",
    "unknown_value",
    "annotation_fields",
    "tipsize",

    "apply_filters",
    "len_policy",
    "gap_policy",
    "noniupac_policy",
    "uppercase",

    "ig_stop_policy",
    "max_tip_categories"
  ],
  "sections": [
    {
      "id": "inputMapping",
      "label": "Input Mapping",
      "order": 0,
      "fields": [
        "doMapping",
        "column_map.sequence_id",
        "column_map.clone_id",
        "column_map.sequence_alignment",
        "column_map.germline_alignment_d_mask",
        "column_map.v_call",
        "column_map.j_call",
        "column_map.junction"
      ]
    }
  ],
  "placeholders": {
    "column_map.sequence_id": "e.g. sequence_id",
    "column_map.clone_id": "e.g. clone_id",
    "column_map.sequence_alignment": "e.g. sequence_alignment",
    "column_map.germline_alignment_d_mask": "e.g. germline_alignment_d_mask",
    "column_map.v_call": "e.g. v_call",
    "column_map.j_call": "e.g. j_call",
    "column_map.junction": "e.g. junction",
    "label_field": "empty = sequence_id",
    "tip_color_by": "empty = no coloring"
  },
  "visibility": {
    "column_map.sequence_id": { "when": { "doMapping": true } },
    "column_map.clone_id": { "when": { "doMapping": true } },
    "column_map.sequence_alignment": { "when": { "doMapping": true } },
    "column_map.germline_alignment_d_mask": { "when": { "doMapping": true } },
    "column_map.v_call": { "when": { "doMapping": true } },
    "column_map.j_call": { "when": { "doMapping": true } },
    "column_map.junction": { "when": { "doMapping": true } },

    "len_policy": { "when": { "apply_filters": true } },
    "gap_policy": { "when": { "apply_filters": true } },
    "noniupac_policy": { "when": { "apply_filters": true } },
    "uppercase": { "when": { "apply_filters": true } },

    "ig_stop_policy": { "when": { "tree_model": "igphyml" } }
  }
}
