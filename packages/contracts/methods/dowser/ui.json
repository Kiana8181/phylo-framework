{
  "requiresFile": true,
  "maxFiles": 1,
  "order": [
    "tree_model",
    "minseq",
    "nproc",
    "label_field",
    "tip_color_by",
    "unknown_value",
    "annotation_fields",
    "tipsize",

    "apply_filters",
    "len_policy",
    "gap_policy",
    "noniupac_policy",
    "uppercase",

    "ig_stop_policy",
    "exec",
    "igphyml_motifs_path",

    "max_tip_categories"
  ],
  "placeholders": {
    "label_field": "empty = sequence_id",
    "tip_color_by": "empty = no coloring",
    "exec": "/usr/local/bin/igphyml",
    "igphyml_motifs_path": "/usr/local/share/igphyml/src/motifs"
  },
  "visibility": {
    "len_policy": { "when": { "apply_filters": true } },
    "gap_policy": { "when": { "apply_filters": true } },
    "noniupac_policy": { "when": { "apply_filters": true } },
    "uppercase": { "when": { "apply_filters": true } },

    "ig_stop_policy": { "when": { "tree_model": "igphyml" } },
    "exec": { "when": { "tree_model": "igphyml" } },
    "igphyml_motifs_path": { "when": { "tree_model": "igphyml" } }
  }
}
