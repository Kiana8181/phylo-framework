{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["ok", "trees", "clones", "annotations", "stats"],
  "properties": {
    "ok": { "type": "boolean" },

    "trees": { "type": "array", "items": { "type": "string" } },

    "figures": {
      "type": ["object", "null"],
      "properties": {
        "svg_text": { "type": "array", "items": { "type": "string" } },
        "png_base64": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },

    "annotations": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": true }
    },

    "clones": {
      "type": "object",
      "required": ["clone_id", "seqs"],
      "properties": {
        "clone_id": { "type": "array", "items": { "type": "string" } },
        "seqs":     { "type": "array", "items": { "type": ["integer", "number"] } }
      },
      "additionalProperties": true
    },

    "stats": {
      "type": "object",
      "properties": {
        "n_unique": { "type": "integer" },
        "n_trees":  { "type": "integer" },
        "pipeline": { "type": "string" }
      },
      "additionalProperties": true
    },

    "render": { "type": ["string", "null"] }
  }
}
