{
  "requiresFile": true,
  "maxFiles": 1,
  "uploadGuidance": [
    "Aligned FASTA, or CSV/TSV with an aligned sequence column (framework converts to FASTA).",
    "For CSV/TSV, one row becomes one FASTA record. duplicate_count and other unused metadata are not sent as GCtree weights; use repeated aligned sequences with distinct IDs only when record multiplicity is intended.",
    "A CSV/TSV does not have to contain the germline row — answer “no” to the germline question and the framework adds it from an ID and aligned sequence you provide.",
    "Single GCtree forest pickle (.p) for re-rank/re-render — set input scenario to gctree_forest_pickle.",
    "For DNAPARS outfile + abundances (and optional idmap, position maps), upload a single .zip containing manifest.json plus the files listed in the manifest (see docs).",
    "If you want to compare across methods, upload a format accepted by all desired methods."
  ],
  "uploadGuidanceLinks": [
    { "label": "Data columns needed across all methods", "href": "/documents/data-requirements" },
    { "label": "This method's field requirements", "href": "/documents/gctree" }
  ],
  "order": [
    "input_scenario",
    "doMapping",
    "column_map.sequence_id",
    "column_map.sequence_alignment",
    "germline_row_present",
    "root",
    "root_sequence_id",
    "root_sequence_alignment",
    "at_abundance",
    "frame",
    "frame2",
    "chain_split",
    "top_n",
    "ranking_strategy",
    "quick",
    "jumble",
    "img_type",
    "outbase",
    "idlabel",
    "show_nucleotide_mutations",
    "summarize_forest",
    "tree_stats",
    "apply_coloring_settings",
    "color_mode",
    "apply_isotype"
  ],
  "sections": [
    {
      "id": "inputMapping",
      "label": "Input & Mapping",
      "order": 0,
      "fields": [
        "input_scenario",
        "doMapping",
        "column_map.sequence_id",
        "column_map.sequence_alignment",
        "germline_row_present",
        "root",
        "root_sequence_id",
        "root_sequence_alignment",
        "at_abundance"
      ]
    },
    {
      "id": "inferenceRanking",
      "label": "Inference & Ranking",
      "order": 1,
      "fields": ["frame", "top_n", "ranking_strategy", "quick", "jumble"]
    },
    {
      "id": "outputRendering",
      "label": "Output Rendering",
      "order": 2,
      "fields": [
        "img_type",
        "outbase",
        "idlabel",
        "show_nucleotide_mutations",
        "summarize_forest",
        "tree_stats",
        "apply_coloring_settings",
        "color_mode"
      ]
    },
    {
      "id": "advanced",
      "label": "Advanced",
      "order": 3,
      "fields": ["frame2", "chain_split", "apply_isotype"]
    }
  ],
  "placeholders": {
    "column_map.sequence_id": "e.g. sequence_id",
    "column_map.sequence_alignment": "e.g. sequence_alignment",
    "root_sequence_id": "e.g. GL",
    "root_sequence_alignment": "e.g. GAGGTGCAGCTGGTGGAGTCTGGGGGA…"
  },
  "widgets": {
    "root_sequence_alignment": "textarea"
  },
  "visibility": {
    "doMapping": { "when": { "$inputFormat": ["csv", "tsv"] } },
    "column_map.sequence_id": {
      "whenAll": [{ "doMapping": true }, { "$inputFormat": ["csv", "tsv"] }]
    },
    "column_map.sequence_alignment": {
      "whenAll": [{ "doMapping": true }, { "$inputFormat": ["csv", "tsv"] }]
    },

    "germline_row_present": {
      "when": { "input_scenario": "airr_or_changeo_table_adapter" }
    },
    "root": {
      "whenAny": [
        { "input_scenario": "aligned_fasta_with_root" },
        {
          "input_scenario": "airr_or_changeo_table_adapter",
          "germline_row_present": "yes"
        }
      ]
    },
    "root_sequence_id": {
      "when": {
        "input_scenario": "airr_or_changeo_table_adapter",
        "germline_row_present": "no"
      }
    },
    "root_sequence_alignment": {
      "when": {
        "input_scenario": "airr_or_changeo_table_adapter",
        "germline_row_present": "no"
      }
    },
    "quick": {
      "whenAny": [
        { "input_scenario": "aligned_fasta_with_root" },
        { "input_scenario": "airr_or_changeo_table_adapter" }
      ]
    },
    "jumble": {
      "whenAny": [
        { "input_scenario": "aligned_fasta_with_root" },
        { "input_scenario": "airr_or_changeo_table_adapter" }
      ]
    },
    "color_mode": { "when": { "apply_coloring_settings": true } },

    "at_abundance": { "when": { "$fastaIdStyle": "at_abundance" } }
  },
  "validation": {
    "requiredWhen": [
      {
        "field": "at_abundance",
        "when": { "$fastaIdStyle": "at_abundance" },
        "message": "Please answer — GCtree cannot interpret “@N” IDs on its own."
      },
      {
        "field": "root_sequence_id",
        "when": {
          "input_scenario": "airr_or_changeo_table_adapter",
          "germline_row_present": "no"
        },
        "message": "Name the germline row the framework will add — it becomes the ID GCtree roots on."
      },
      {
        "field": "root_sequence_alignment",
        "when": {
          "input_scenario": "airr_or_changeo_table_adapter",
          "germline_row_present": "no"
        },
        "message": "Paste the aligned germline sequence — it must be the same length as the other aligned sequences."
      }
    ]
  }
}
